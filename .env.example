# Copy to .env and fill in. NEVER commit a real .env.

# --- Infrastructure ---
DATABASE_URL=postgresql://medinfo:medinfo@localhost:5432/medinfo
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- VLM provider (medicine-box extraction) ---
# qwen  -> default, no API cost (self-hosted Qwen2-VL via an OpenAI-compatible endpoint: vLLM / Ollama)
# claude-> optional swap-in (paid)
VLM_PROVIDER=qwen

# Qwen2-VL (OpenAI-compatible). Example: http://localhost:11434/v1 (Ollama) or your vLLM server.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2-vl:7b
# Text model used for reformatting/translation when REFORMAT_PROVIDER=qwen (defaults to QWEN_MODEL).
QWEN_TEXT_MODEL=qwen2.5:7b

# Claude (only used when VLM_PROVIDER=claude or REFORMAT_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_VLM_MODEL=claude-opus-4-8
CLAUDE_TEXT_MODEL=claude-opus-4-8

# --- Embedding provider (multilingual NL/FR/DE/EN/AR/TR) ---
# bge-m3 -> real multilingual embeddings via an OpenAI-compatible endpoint.
# hash   -> deterministic, dependency-free embeddings for offline dev/tests.
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# --- Ingestion (Belgium SAM + FAMHP leaflets) ---
# Path to the SAM "Actual Medicinal Products" XML export. Defaults to the bundled
# offline sample when unset.
SAM_AMP_PATH=
# Offline leaflet text fixtures (<ampCode>_<lang>.txt). Set to skip PDF downloads.
LEAFLET_FIXTURE_DIR=

# --- Reformat / translate provider (leaflet readability + on-demand translation) ---
# Reuses the VLM/text provider config above by default. Override here if separate.
REFORMAT_PROVIDER=qwen

# --- API server ---
PORT=3000
# Directory where uploaded box images are stored. Use a persistent volume in prod,
# or set IMAGE_RETENTION_HOURS=0 to avoid persisting images at all.
IMAGE_DIR=./data/images
# How long uploaded box images are retained before auto-deletion (hours).
# Users can also delete immediately from Settings. 0 = delete right after extraction.
IMAGE_RETENTION_HOURS=24

# --- Mobile app (set in apps/mobile, NOT this backend .env) ---
# Base URL the Expo app calls. Use your machine's LAN IP on a physical device,
# not localhost. Example: EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
