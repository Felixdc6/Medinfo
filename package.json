{
  "name": "medinfo",
  "version": "0.0.0",
  "private": true,
  "description": "Medication leaflet app: photograph a medicine box, identify it, and read a reformatted, multilingual version of its official leaflet.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @medinfo/api dev",
    "ingest": "pnpm --filter @medinfo/ingestion start",
    "dev:mobile": "pnpm --filter @medinfo/mobile start",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  }
}
